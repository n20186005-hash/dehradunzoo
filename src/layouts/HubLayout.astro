---
import '../styles/global.css';
import { attraction, abs, canonicalHome, mapUrl, sources } from '../data/attraction';
import { pageBySlug, topNavSlugs } from '../data/cluster';
import type { ClusterPage } from '../data/types';

interface Props {
  lang: 'en' | 'hi';
  title: string;
  metaDescription: string;
  h1: string;
  intro: string;
  canonicalPath: string;
}

const { lang, title, metaDescription, h1, intro, canonicalPath } = Astro.props;
const isHi = lang === 'hi';

const canonical = abs(canonicalPath);
const ogImage = abs('/images/malsi-spotted-deer.jpg');

const navItems = topNavSlugs.map((s) => pageBySlug.get(s)).filter((p): p is ClusterPage => Boolean(p));
const pageHref = (s: string) => (isHi ? `/hi/${s}/` : `/${s}/`);

const ui = isHi
  ? { home: 'मुखपृष्ठ', openMap: 'दिशा खोलें', alt: 'English', altCode: 'en', altUrl: '/guides/' }
  : { home: 'Home', openMap: 'Open directions', alt: 'हिन्दी', altCode: 'hi', altUrl: '/hi/' };

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: attraction.fullName, item: canonicalHome },
    { '@type': 'ListItem', position: 2, name: h1, item: canonical }
  ]
};
---
<!doctype html>
<html lang={isHi ? 'hi-IN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#123c2d" />
    <link rel="alternate" hreflang="en" href={abs('/guides/')} />
    <link rel="alternate" hreflang="hi" href={abs('/hi/')} />
    <link rel="alternate" hreflang="x-default" href={abs('/guides/')} />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dehradun Zoo Visitor Guide" />
    <meta property="og:locale" content={isHi ? 'hi_IN' : 'en_IN'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline src="/ga4.js"></script>
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#123c2d]/95 text-white backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-5 py-3 lg:px-8">
        <a href={isHi ? '/hi/' : '/'} aria-label={ui.home} class="shrink-0"><img src="/icons/logo.svg" alt="देहरादून जू (Dehradun Zoo)" class="h-11 w-auto" /></a>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] font-semibold">
          {navItems.map((p) => (<a class="hover:text-[#d9a441]" href={pageHref(p.slug)}>{isHi ? p.hi.h1 : p.en.h1}</a>))}
        </nav>
        <div class="flex items-center gap-3">
          <a href={ui.altUrl} hreflang={ui.altCode} class="rounded-full border border-white/30 px-3 py-1.5 text-xs font-bold">{ui.alt}</a>
          <a href={mapUrl} class="rounded-full bg-[#d9a441] px-4 py-2 text-sm font-black text-[#173326]">{ui.openMap}</a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="forest-grid relative overflow-hidden bg-[#123c2d] text-white">
        <div class="mx-auto max-w-4xl px-5 pb-12 pt-12 lg:px-8 lg:pb-16 lg:pt-16">
          <h1 class="text-4xl font-black leading-tight sm:text-5xl">{h1}</h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-white/85">{intro}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={isHi ? '/hi/' : '/'} class="rounded-full bg-white px-5 py-2.5 text-sm font-black text-[#123c2d]">{isHi ? 'मुख्य गाइड' : 'Main guide'}</a>
            <a href={mapUrl} class="rounded-full border border-white/30 px-5 py-2.5 text-sm font-bold">{ui.openMap}</a>
          </div>
        </div>
      </section>

      <article class="mx-auto max-w-5xl px-5 py-14 lg:px-8 lg:py-20">
        <slot />
        <p class="mt-12 text-sm leading-6 text-black/60">
          {isHi ? 'यह एक स्वतंत्र, गैर-लाभकारी गाइड है; आधिकारिक वेबसाइट नहीं।' : 'An independent nonprofit guide; not the official website.'}
          <a class="underline" href={sources.gov} target="_blank" rel="noopener noreferrer">Dehradun Nagar Nigam</a> ·
          <a class="underline" href={sources.maps} target="_blank" rel="noopener noreferrer">Google Maps</a>
        </p>
      </article>
    </main>

    <footer class="bg-[#0d2d22] text-white">
      <div class="mx-auto max-w-7xl px-5 py-8 lg:px-8">
        <p class="text-sm text-white/65">© {new Date().getFullYear()} {attraction.domain} · {attraction.fullName} ({attraction.legacyName})</p>
      </div>
    </footer>

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () { navigator.serviceWorker.register('/sw.js').catch(function () {}); });
      }
    </script>
  </body>
</html>

---
import '../styles/global.css';

/* ------------------------------------------------------------------ *
 * Single-attraction SEO entity binding configuration.
 * Every <title>, meta tag, schema node, heading and alt text below is
 * derived from this one object, so binding another attraction only
 * means editing these values.
 *
 * DOMAIN_NAME               -> attraction.domain      (dehradunzoo.com)
 * ATTRACTION_FULL_NAME      -> attraction.fullName    (Dehradun Zoo)
 * ATTRACTION_SHORT_NAME     -> attraction.shortName   (Malsi Deer Park)
 * CITY_NAME                 -> attraction.city        (Dehradun)
 * STATE_PROVINCE            -> attraction.state       (Uttarakhand)
 * COUNTRY_NAME              -> attraction.country     (India)
 * COUNTRY_CODE_2LETTER      -> attraction.countryCode (IN)
 * POSTAL_CODE               -> attraction.postalCode  (248009)
 * LATITUDE / LONGITUDE      -> attraction.latitude / .longitude
 * MAPS_SHARE_URL            -> mapUrl
 * MAPS_EMBED_SRC            -> mapEmbedSrc
 * NEARBY_LANDMARK_1/2       -> attraction.nearbyLandmarks
 * GOVT_TOURISM_URL          -> tourismUrl
 * ------------------------------------------------------------------ */
const attraction = {
  domain: 'dehradunzoo.com',
  fullName: 'Dehradun Zoo',
  shortName: 'Malsi Deer Park',
  legacyName: 'Malsi Deer Park',
  city: 'Dehradun',
  state: 'Uttarakhand',
  country: 'India',
  countryCode: 'IN',
  postalCode: '248009',
  streetAddress: 'Diversion, Mussoorie Road, Malsi',
  latitude: 30.3900817,
  longitude: 78.0752725,
  plusCode: '93RG+24',
  phone: '+919027174404',
  phoneDisplay: '+91 90271 74404',
  category: 'Zoo / wildlife park',
  ratingValue: '4.2',
  reviewCount: '21742',
  nearbyLandmarks: ["Robber's Cave (Gucchhu Pani)", 'MDDA Park / Rajpur Road', 'Forest Research Institute']
};

const siteOrigin = Astro.site ? new URL('/', Astro.site).origin : `https://${attraction.domain}`;
const canonical = `${siteOrigin}/`;
const abs = (path: string) => new URL(path, `${siteOrigin}/`).toString();

const mapUrl = 'https://maps.app.goo.gl/Egak7AZJp3zzA7s88';
const mapEmbedSrc = 'https://www.google.com/maps?q=30.3900817,78.0752725&output=embed';
// Authoritative outbound references (E-E-A-T + local citation signals).
const govUrl = 'https://nndehradun.uk.gov.in/places-centres/malsi-deer-park/';
const tourismUrl = 'https://uttarakhandtourism.gov.in/';
const forestUrl = 'https://forest.uk.gov.in/';

// Genuine Dehradun Zoo / Malsi Deer Park photos served locally.
// Origin, author and licence for every file: public/images/IMAGE-SOURCES.md
const photos = {
  hero: '/images/malsi-spotted-deer.jpg',
  deer: '/images/malsi-spotted-deer.jpg',
  monkey: '/images/malsi-rhesus-macaque.jpg'
};
const heroAlt = `Historical 2010 photograph of spotted deer at Malsi Deer Park, Dehradun; not a guarantee of current displays`;
const ogImage = abs('/images/malsi-spotted-deer.jpg');

const faq = [
  { q: 'देहरादून जू किस दिन बंद रहता है?', a: '29 अक्टूबर 2026 की जाँच में वर्तमान साप्ताहिक बंद दिन की आधिकारिक पुष्टि नहीं मिली। जाने से पहले सोमवार सहित अपने चुने हुए दिन का प्रवेश और अंतिम प्रवेश समय जाँचें।' },
  { q: 'यहां कितना समय रखना चाहिए?', a: 'योजना बनाते समय लगभग 2–3 घंटे का लचीला समय रख सकते हैं। यह सुझाव है, तय अवधि नहीं; उस दिन खुले क्षेत्रों, रास्तों, मौसम और अपने समूह की जरूरतों के अनुसार समय बदलें।' },
  { q: 'क्या पार्किंग उपलब्ध है?', a: 'पार्किंग की वर्तमान उपलब्धता और शुल्क की पुष्टि नहीं हुई है। आने से पहले निर्धारित पार्किंग और सुरक्षित उतरने की जगह पूछें; सड़क रोककर वाहन न खड़ा करें।' },
  { q: 'क्या बच्चों के लिए उपयुक्त है?', a: 'हाँ। यह एक छोटा, हरियाली वाला जूलॉजिकल पार्क है और परिवारों के लिए लोकप्रिय है। चुने हुए दिन खुले क्षेत्रों, रास्तों और बच्चों की जरूरतों की जाँच करें; किसी विशेष पशु या सुविधा के उपलब्ध होने की गारंटी नहीं है।' },
  { q: 'टिकट कितने का है?', a: 'वर्तमान आधिकारिक शुल्क और बच्चों की छूट की पुष्टि नहीं हुई है। भुगतान से पहले प्रवेश शुल्क, आयु-सीमा और अलग गतिविधियों के शुल्क काउंटर से जाँचें।' }
];

// English FAQ set — rendered in the Visitor Guide section and merged into the
// single FAQPage node so both languages share one structured-data block.
const faqEn = [
  { q: 'Where is Dehradun Zoo located?', a: 'Dehradun Zoo is located at Diversion, Mussoorie Road, Malsi, Dehradun, Uttarakhand 248009, India (plus code 93RG+24), on the road that climbs from the city towards Mussoorie.' },
  { q: 'Is Dehradun Zoo free to visit?', a: 'A current official admission tariff or free-entry concession has not been verified. Check the adult price, child eligibility and any separately charged activities with the counter before paying.' },
  { q: 'What are Dehradun Zoo opening hours?', a: 'Google Maps displayed an opening signal of 09:00 when checked on 29 October 2026. This does not establish the closing time, last entry or weekly schedule. Confirm your chosen day with the operator.' },
  { q: 'What was Dehradun Zoo previously called?', a: 'Dehradun Zoo was formerly known as Malsi Deer Park, and the Malsi name is still widely used locally for the same site on Mussoorie Road.' },
  { q: 'How far is Dehradun Zoo from the city centre?', a: 'Official information places the site roughly 9 km from Clock Tower in central Dehradun, reached by taxi, auto-rickshaw or private car along Mussoorie Road towards Malsi.' },
  { q: 'How much time should I spend at Dehradun Zoo?', a: 'Allow a flexible 2–3 hours as a planning suggestion, rather than a fixed tour duration. Adjust to the areas actually open, walking conditions, weather and your group’s needs; particular facilities are not guaranteed.' },
  { q: 'Which landmarks can I combine with a Dehradun Zoo visit?', a: 'Robber’s Cave, MDDA Park and the Forest Research Institute are separate outing ideas, not a verified continuous route. Check each destination’s location, access and transport independently.' },
  { q: 'Is Dehradun Zoo suitable for children?', a: 'Yes. It is a compact, green zoological park that is popular with families, but check the open areas, walking conditions and your children’s needs on the day; particular animals or facilities are not guaranteed.' },
  { q: 'What is the ticket price (entry fee) for Dehradun Zoo?', a: 'Current official fees and age-based concessions have not been verified. Ask the counter about adult and child tickets, any proof of age, and separately priced activities before paying.' },
  { q: 'Is Dehradun Zoo on the way to Mussoorie?', a: 'Yes. Dehradun Zoo (Malsi Deer Park) sits on Mussoorie Road at Malsi, the same route that climbs from Dehradun to Mussoorie, making it a convenient stop for travellers heading up or down the hill.' }
];

const attractionLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Zoo'],
  '@id': `${siteOrigin}/#attraction`,
  name: attraction.fullName,
  alternateName: [
    'देहरादून जू',
    'Malsi Deer Park',
    'मालसी डियर पार्क',
    `${attraction.fullName} and ${attraction.legacyName}`,
    `${attraction.city} Zoo`
  ],
  description: `${attraction.fullName} (${attraction.legacyName}) is a wildlife park on Mussoorie Road in Malsi, ${attraction.city}, ${attraction.state}, ${attraction.country}, known for ex-situ conservation, biodiversity education, wildlife rescue and family nature walks.`,
  url: canonical,
  mainEntityOfPage: canonical,
  image: [
    abs('/images/malsi-spotted-deer.jpg'),
    abs('/images/malsi-rhesus-macaque.jpg')
  ],
  telephone: attraction.phone,
  hasMap: mapUrl,
  containedInPlace: {
    '@type': 'City',
    name: attraction.city,
    address: {
      '@type': 'PostalAddress',
      addressRegion: attraction.state,
      addressCountry: attraction.countryCode
    }
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: attraction.streetAddress,
    addressLocality: attraction.city,
    addressRegion: attraction.state,
    postalCode: attraction.postalCode,
    addressCountry: attraction.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude
  },
  sameAs: [mapUrl]
};

// Geographic ownership chain: Attraction -> City -> State -> Country
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${siteOrigin}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: `${attraction.fullName} (${attraction.legacyName})`, item: canonical },
    { '@type': 'ListItem', position: 2, name: attraction.city, item: 'https://en.wikipedia.org/wiki/Dehradun' },
    { '@type': 'ListItem', position: 3, name: attraction.state, item: 'https://en.wikipedia.org/wiki/Uttarakhand' },
    { '@type': 'ListItem', position: 4, name: attraction.country, item: 'https://en.wikipedia.org/wiki/India' }
  ]
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteOrigin}/#website`,
  url: canonical,
  name: `${attraction.fullName} (${attraction.legacyName}) Visitor Guide`,
  alternateName: [`${attraction.domain} — ${attraction.fullName}`, 'देहरादून जू यात्रा मार्गदर्शिका'],
  inLanguage: ['hi-IN', 'en'],
  about: { '@id': `${siteOrigin}/#attraction` }
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${siteOrigin}/#faq`,
  mainEntity: [...faq, ...faqEn].map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---
<!doctype html>
<html lang="hi-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- ===== 2. TDK: title / description / canonical ===== -->
    <title>देहरादून जू (Dehradun Zoo) — Malsi Deer Park | Timings, Ticket Price &amp; Location</title>
    <meta name="description" content="देहरादून जू / मालसी डियर पार्क यात्रा गाइड: समय और टिकट की पुष्टि, सही पता, ऐतिहासिक तस्वीरें और संरक्षण संदर्भ। Dehradun Zoo visitor planning and map." />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <meta name="theme-color" content="#123c2d" />
    <meta name="format-detection" content="telephone=yes" />

    <!-- ===== Geographic entity signals ===== -->
    <meta name="geo.region" content="IN-UT" />
    <meta name="geo.placename" content={`Malsi, ${attraction.city}`} />
    <meta name="geo.position" content={`${attraction.latitude};${attraction.longitude}`} />
    <meta name="ICBM" content={`${attraction.latitude}, ${attraction.longitude}`} />

    <!-- ===== Icons + PWA ===== -->
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="application-name" content="देहरादून जू" />
    <meta name="apple-mobile-web-app-title" content="देहरादून जू" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="msapplication-TileColor" content="#123c2d" />

    <!-- ===== Open Graph / Twitter ===== -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dehradun Zoo Visitor Guide" />
    <meta property="og:locale" content="hi_IN" />
    <meta property="og:locale:alternate" content="en_IN" />
    <meta property="og:title" content={`देहरादून जू (${attraction.fullName}) — ${attraction.city} Travel Guide`} />
    <meta property="og:description" content={`Visitor guide to ${attraction.fullName} (${attraction.legacyName}) on Mussoorie Road, ${attraction.city}, ${attraction.state} — how to confirm current access hours and admission charges, with a location map and देहरादून जू हिंदी यात्रा गाइड; not a verified current timetable or tariff.`} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1400" />
    <meta property="og:image:height" content="1050" />
    <meta property="og:image:alt" content={heroAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${attraction.fullName} (${attraction.city}) — Visitor Guide & Location`} />
    <meta name="twitter:description" content={`Location and planning guidance for ${attraction.fullName}, ${attraction.city}: confirm current hours and admission charges with the operator; no verified current tariff or full schedule.`} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={heroAlt} />

    <!-- ===== 1. Structured data (Schema.org / JSON-LD) ===== -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(attractionLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

    <!-- ===== Analytics ===== -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline src="/ga4.js"></script>
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-white/10 bg-[#123c2d]/95 text-white backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-3 lg:px-8">
        <a href="#top" aria-label="मुखपृष्ठ" class="shrink-0"><img src="/icons/logo.svg" alt="देहरादून जू" class="h-11 w-auto" /></a>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-[13px] font-semibold">
          <a class="hover:text-[#d9a441]" href="#plan">यात्रा योजना</a>
          <a class="hover:text-[#d9a441]" href="#reach">कैसे पहुँचें</a>
          <a class="hover:text-[#d9a441]" href="#guide">Visitor Guide</a>
          <a class="hover:text-[#d9a441]" href="#nearby">आस-पास</a>
          <a class="hover:text-[#d9a441]" href="#faq">FAQ</a>
          <a class="hover:text-[#d9a441]" href="#sources">Sources</a>
        </nav>
        <a href={mapUrl} class="rounded-full bg-[#d9a441] px-4 py-2 text-sm font-black text-[#173326]">दिशा खोलें</a>
      </div>
    </header>

    <main id="top">
      <section class="forest-grid relative overflow-hidden bg-[#123c2d] text-white">
        <div class="absolute inset-0 opacity-35">
          <img src={photos.hero} alt={heroAlt} width="1400" height="1050" class="h-full w-full object-cover" loading="eager" fetchpriority="high" decoding="async" />
          <div class="absolute inset-0" style="background-image:linear-gradient(90deg,#123c2d 4%,#123c2dc4 48%,#123c2d22 100%);"></div>
        </div>
        <div class="relative mx-auto grid min-h-[760px] max-w-7xl items-end gap-10 px-5 pb-16 pt-28 lg:grid-cols-[1.15fr_.85fr] lg:px-8 lg:pb-24">
          <div>
            <div class="mb-5 flex flex-wrap gap-2 text-sm font-bold">
              <span class="badge rounded-full px-3 py-1.5">शिवालिक की तलहटी</span>
              <span class="badge rounded-full px-3 py-1.5">मालसी • मसूरी रोड</span>
              <span class="badge rounded-full px-3 py-1.5">★ 4.2 · 21,742 समीक्षाएँ · 29-10-2026</span>
            </div>
            <p class="mb-3 text-sm font-extrabold uppercase tracking-[.22em] text-[#c7dda3]">पूर्व नाम: मालसी डियर पार्क</p>
            <h1 class="max-w-3xl text-5xl font-black leading-[1.05] sm:text-6xl lg:text-7xl">देहरादून जू <span class="mt-3 block text-lg font-extrabold leading-snug text-[#c7dda3] sm:text-2xl lg:text-3xl">Dehradun Zoo · Malsi Deer Park · Dehradun, India</span></h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-white/82 sm:text-xl">शहर से पहाड़ों की ओर बढ़ते रास्ते पर एक हरा-भरा छोटा जूलॉजिकल पार्क—जहाँ वन्यजीव अवलोकन, जैव-विविधता शिक्षा और परिवार के साथ धीमी प्रकृति-यात्रा एक साथ मिलती है।</p>
            <p class="mt-4 max-w-2xl text-base leading-7 text-white/72" lang="en">
              Welcome to <strong class="font-black text-white">Dehradun Zoo</strong>, formerly called <strong class="font-black text-white">Malsi Deer Park</strong>. Located at Malsi on Mussoorie Road outside central <strong class="font-black text-white">Dehradun</strong>, <strong class="font-black text-white">Uttarakhand</strong>, <strong class="font-black text-white">India</strong>, use the exact map pin rather than assuming a city-centre location.
            </p>
            <p class="mt-4 text-sm text-white/80"><a href="#photo-credits" class="underline">ऐतिहासिक फोटो / Historical photo: Akshita.b1, 2010 · CC BY-SA 4.0</a></p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#plan" class="rounded-full bg-white px-6 py-3 font-black text-[#123c2d]">यात्रा की योजना</a>
              <a href="tel:+919027174404" class="rounded-full border border-white/30 px-6 py-3 font-bold">+91 90271 74404</a>
            </div>
          </div>
          <aside class="paper rounded-[2rem] p-6 text-[#17221d] sm:p-8">
            <p class="section-kicker">एक नज़र में</p>
            <div class="mt-5 grid grid-cols-2 gap-4">
              <div class="rounded-2xl bg-[#e8efd9] p-4"><div class="text-xs font-bold text-[#5b6b4d]">Maps संकेत · 29-10-2026</div><div class="mt-1 text-xl font-black">खुलना 09:00*</div></div>
              <div class="rounded-2xl bg-[#f3e8cb] p-4"><div class="text-xs font-bold text-[#796b48]">साप्ताहिक बंद दिन</div><div class="mt-1 text-xl font-black">पुष्टि करें</div></div>
              <div class="rounded-2xl bg-[#e9eee8] p-4"><div class="text-xs font-bold text-[#5a6860]">सुझाया समय</div><div class="mt-1 text-xl font-black">2–3 घंटे</div></div>
              <div class="rounded-2xl bg-[#e9eee8] p-4"><div class="text-xs font-bold text-[#5a6860]">वयस्क टिकट*</div><div class="mt-1 text-xl font-black">काउंटर से पूछें</div></div>
            </div>
            <p class="mt-4 text-xs leading-5 text-black/55">* Maps का 09:00 संकेत पूर्ण साप्ताहिक समय-सारणी नहीं है। अंतिम प्रवेश, बंद समय और टिकट दर काउंटर से पूछें।</p>
            <div class="mt-6 border-t border-black/10 pt-5 text-sm leading-6"><strong>पता:</strong><br/>Diversion, Mussoorie Rd, Malsi, Dehradun, Uttarakhand 248009</div>
          </aside>
        </div>
      </section>

      <section class="mx-auto max-w-7xl px-5 py-16 lg:px-8 lg:py-24">
        <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-center">
          <div>
            <p class="section-kicker">यह जगह क्यों खास है</p>
            <h2 class="mt-3 text-4xl font-black leading-tight sm:text-5xl">चिड़ियाघर से अधिक—एक संरक्षण और प्रकृति-शिक्षा स्थल</h2>
            <p class="mt-5 text-lg leading-8 text-black/70">नगर निगम देहरादून के अनुसार यह स्थल पहले मालसी डियर पार्क के नाम से जाना जाता था। इसका उद्देश्य वन्यजीवों का ex-situ संरक्षण, जैव-विविधता संरक्षण, शिक्षा और वन्यजीव बचाव से जुड़ा है।</p>
            <a class="mt-6 inline-flex font-black text-[#1e563d] underline decoration-[#d9a441] decoration-2 underline-offset-4" href={govUrl}>सरकारी जानकारी देखें ↗</a>
